rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Verify if the signed-in user is an administrator
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['lord79915@gmail.com', 'xenolord128@gmail.com', 'admin@patowary.com'] ||
        request.auth.token.admin == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document for initial load health check
    match /test/{docId} {
      allow read: if true;
    }

    // --- Users Profile Collection Validation ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(request.resource.data);
    }

    function isValidUser(u) {
      return u.uid == request.auth.uid 
        && (u.email == null || u.email is string)
        && (u.displayName == null || u.displayName is string)
        && (u.photoURL == null || u.photoURL is string)
        && (u.role == null || u.role is string)
        && (u.updatedAt == null || u.updatedAt is string);
    }

    // --- Products Collection Validation ---
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(request.resource.data);
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isSignedIn();
    }

    function isValidProduct(p) {
      return (p.id is number || p.id is string)
        && p.title is string && p.title.size() <= 300
        && p.category is string && p.category.size() <= 100
        && p.price is number && p.price >= 0
        && (p.regularPrice == null || (p.regularPrice is number && p.regularPrice >= 0))
        && (p.discountPercent == null || (p.discountPercent is number && p.discountPercent >= 0 && p.discountPercent <= 100))
        && (p.salePrice == null || (p.salePrice is number && p.salePrice >= 0))
        && (p.rating == null || (p.rating is number && p.rating >= 0 && p.rating <= 5))
        && (p.assets == null || (p.assets is list && p.assets.size() <= 25))
        && (p.variants == null || (p.variants is list && p.variants.size() <= 25))
        && (p.outOfStock == null || (p.outOfStock is list && p.outOfStock.size() <= 25))
        && (p.description == null || (p.description is string && p.description.size() <= 5000))
        && (p.reviews == null || p.reviews is list)
        && (p.stock == null || (p.stock is number && p.stock >= 0))
        && (p.status == null || (p.status is string && p.status.size() <= 50))
        && (p.createdAt == null || p.createdAt is string);
    }

    // --- Categories Collection Validation ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- Promo Codes Collection Validation ---
    match /promocodes/{promoId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // --- Orders Collection Validation ---
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    function isValidOrder(o) {
      return o.id is string && o.id.size() <= 100
        && o.fullName is string && o.fullName.size() <= 200
        && o.phone is string && o.phone.size() <= 50
        && o.address is string && o.address.size() <= 500
        && o.paymentMethod is string && o.paymentMethod.size() <= 100
        && o.items is list && o.items.size() <= 50
        && o.totalPrice is number && o.totalPrice >= 0
        && o.status is string && o.status in ['Received', 'Processing', 'Shipped', 'Out for Delivery', 'Completed']
        && o.createdAt is string;
    }

    // --- Settings Documents Verification ---
    match /settings/{settingsId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }
  }
}
