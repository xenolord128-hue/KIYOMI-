{
  "entities": {
    "product": {
      "title": "Product",
      "description": "Premium apparel product listing details.",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric unique identifier" },
        "title": { "type": "string", "description": "Formal product title" },
        "category": { "type": "string", "description": "Apparel category name" },
        "price": { "type": "number", "description": "Active selling price of the product" },
        "regularPrice": { "type": "number", "description": "Original regular price before discount" },
        "discountPercent": { "type": "number", "description": "Discount percentage (0-100)" },
        "salePrice": { "type": "number", "description": "Calculated sale price" },
        "rating": { "type": "number", "description": "Average user rating" },
        "assets": { "type": "array", "description": "List of high-resolution image URLs" },
        "variants": { "type": "array", "description": "Sizing or styling variants list" },
        "outOfStock": { "type": "array", "description": "List of current out-of-stock variants" },
        "description": { "type": "string", "description": "Textual product summary details" },
        "reviews": { "type": "array", "description": "List of user-submitted reviews" },
        "stock": { "type": "number", "description": "Total stock left" },
        "status": { "type": "string", "description": "active or draft" }
      },
      "required": ["id", "title", "category", "price", "description"]
    },
    "category": {
      "title": "Category",
      "description": "Apparel collection category taxonomy.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category identifier" },
        "name": { "type": "string", "description": "Category title in English" },
        "nameBn": { "type": "string", "description": "Category title in Bengali" },
        "slug": { "type": "string", "description": "URL slug" },
        "description": { "type": "string", "description": "Category summary description" },
        "image": { "type": "string", "description": "Featured image URL" },
        "status": { "type": "string", "description": "active or inactive" },
        "productCount": { "type": "number", "description": "Count of assigned products" }
      },
      "required": ["id", "name"]
    },
    "promoCode": {
      "title": "PromoCode",
      "description": "Promotional coupon discount voucher entity.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Uppercase coupon code" },
        "discountType": { "type": "string", "description": "percentage or fixed" },
        "discountValue": { "type": "number", "description": "Discount rate or amount" },
        "minOrderAmount": { "type": "number", "description": "Minimum subtotal required to apply" },
        "maxDiscount": { "type": "number", "description": "Maximum allowed discount amount" },
        "startDate": { "type": "string", "description": "Valid from date" },
        "endDate": { "type": "string", "description": "Expiration deadline date" },
        "usageLimit": { "type": "number", "description": "Maximum number of redemptions" },
        "usedCount": { "type": "number", "description": "Total redemptions" },
        "status": { "type": "string", "description": "active, inactive, or expired" }
      },
      "required": ["code", "discountType", "discountValue", "status"]
    },
    "order": {
      "title": "Order",
      "description": "E-commerce order detail captured during premium checkout.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique order or invoice tracking identifier" },
        "fullName": { "type": "string", "description": "Full name of the recipient" },
        "phone": { "type": "string", "description": "Mobile number of the recipient" },
        "address": { "type": "string", "description": "Shipping courier delivery address" },
        "paymentMethod": { "type": "string", "description": "Selected payment terms" },
        "items": { "type": "array", "description": "List of purchased items and metadata" },
        "totalPrice": { "type": "number", "description": "Total price including tax and discounts" },
        "status": { "type": "string", "enum": ["Received", "Processing", "Shipped", "Out for Delivery", "Completed"] },
        "createdAt": { "type": "string", "description": "ISO timestamp when client placed the invoice" }
      },
      "required": ["id", "fullName", "phone", "address", "paymentMethod", "items", "totalPrice", "status", "createdAt"]
    },
    "announcement": {
      "title": "Announcement",
      "description": "Top notice bar message block configure by brand administrators.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["message", "active"]
    },
    "adConfig": {
      "title": "AdConfig",
      "description": "Dynamic script configuration block for monetization.",
      "type": "object",
      "properties": {
        "scriptBlock": { "type": "string" },
        "enabled": { "type": "boolean" },
        "intervalSeconds": { "type": "number" }
      },
      "required": ["scriptBlock", "enabled"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "product",
      "description": "Individual product detail document"
    },
    "/categories/{categoryId}": {
      "schema": "category",
      "description": "Category item document"
    },
    "/promocodes/{codeId}": {
      "schema": "promoCode",
      "description": "Promotional coupon code document"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Individual premium order shipment detail"
    },
    "/announcements/{announcementId}": {
      "schema": "announcement",
      "description": "Broadcasting header banner notification message"
    },
    "/adConfigs/{configId}": {
      "schema": "adConfig",
      "description": "Dynamic script placements and settings database node"
    }
  }
}
